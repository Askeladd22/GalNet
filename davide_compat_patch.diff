+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+        </do_if>
+      </actions>
+    </cue>
+
+    <cue name="PrisonBuildBackstop" instantiate="true" checktime="45min" checkinterval="90min">
+      <actions>
+        <set_value name="$PrisonFactionList" exact="[faction.scaleplate, faction.split, faction.freesplit]"/>
+        <do_if value="faction.loanshark?">
+          <append_to_list name="$PrisonFactionList" exact="faction.loanshark"/>
+        </do_if>
+        <do_if value="faction.yaki?">
+          <append_to_list name="$PrisonFactionList" exact="faction.yaki"/>
+        </do_if>
+        <do_if value="faction.buccaneers?">
+          <append_to_list name="$PrisonFactionList" exact="faction.buccaneers"/>
+        </do_if>
+        <do_if value="faction.fallensplit?">
+          <append_to_list name="$PrisonFactionList" exact="faction.fallensplit"/>
+        </do_if>
+
+        <shuffle_list list="$PrisonFactionList"/>
+        <set_value name="$CreatedThisPass" exact="false"/>
+
+        <do_all exact="$PrisonFactionList.count" counter="$pf_i">
+          <do_if value="not $CreatedThisPass">
+            <set_value name="$PrisonFaction" exact="$PrisonFactionList.{$pf_i}"/>
+
+            <do_if value="$PrisonFaction.isactive">
+              <set_value name="$DesiredPrisonStations" exact="1"/>
+              <do_if value="$PrisonFaction == faction.split">
+                <set_value name="$DesiredPrisonStations" exact="2"/>
+              </do_if>
+
+              <set_value name="$PrisonStationCount" exact="0"/>
+              <find_station_by_true_owner name="$FactionStations_All" faction="$PrisonFaction" space="player.galaxy" multiple="true" checkoperational="false"/>
+              <do_all exact="$FactionStations_All.count" counter="$ps_i">
+                <set_value name="$Station" exact="$FactionStations_All.{$ps_i}"/>
+                <set_value name="$HasPrisonModule" exact="false"/>
+                <do_all exact="$Station.productions.count" counter="$pm_i">
+                  <do_if value="$Station.productions.{$pm_i}.macro == macro.prod_spl_strafkolonie_macro">
+                    <set_value name="$HasPrisonModule" exact="true"/>
+                    <break/>
+                  </do_if>
+                </do_all>
+                <do_if value="$HasPrisonModule">
+                  <set_value name="$PrisonStationCount" operation="add"/>
+                </do_if>
+              </do_all>
+
+              <do_if value="$PrisonStationCount lt $DesiredPrisonStations">
+                <set_value name="$SpawnSectors" exact="[]"/>
+                <find_sector name="$OwnedPrisonSectors" owner="$PrisonFaction" multiple="true"/>
+                <do_if value="$OwnedPrisonSectors.count">
+                  <append_list_elements name="$SpawnSectors" other="$OwnedPrisonSectors"/>
+                </do_if>
+                <do_if value="not $SpawnSectors.count">
+                  <do_all exact="$FactionStations_All.count" counter="$fs_i">
+                    <do_if value="$FactionStations_All.{$fs_i}.exists and $FactionStations_All.{$fs_i}.sector">
+                      <append_to_list name="$SpawnSectors" exact="$FactionStations_All.{$fs_i}.sector"/>
+                    </do_if>
+                  </do_all>
+                </do_if>
+
+                <do_if value="$SpawnSectors.count">
+                  <set_value name="$ChosenSector" exact="$SpawnSectors.random"/>
+                  <set_value name="$PrisonPlan" exact="if ($PrisonFaction == faction.scaleplate) or (faction.loanshark? and $PrisonFaction == faction.loanshark) or (faction.yaki? and $PrisonFaction == faction.yaki) or (faction.buccaneers? and $PrisonFaction == faction.buccaneers) then 'fab_sca_strafkolonie' else 'fab_spl_strafkolonie'"/>
+                  <set_value name="$PrisonName" exact="if $PrisonFaction == faction.scaleplate then {990100,4003} else if $PrisonFaction == faction.freesplit then {990100,4002} else {990100,4001}"/>
+
+                  <create_station name="$NewPrison" sector="$ChosenSector" owner="$PrisonFaction" macro="macro.station_gen_factory_base_01_macro" rawname="$PrisonName" state="componentstate.operational" constructionplan="$PrisonPlan">
+                    <safepos allowyaxis="false" includeplotbox="true"/>
+                  </create_station>
+
+                  <do_if value="$NewPrison">
+                    <signal_objects object="player.galaxy" param="'init station'" param2="$NewPrison" param3="false"/>
+                    <add_default_production_wares object="$NewPrison" lowerlimit="10" upperlimit="10"/>
+                    <set_value name="$CreatedThisPass" exact="true"/>
+                  </do_if>
+                </do_if>
+              </do_if>
+            </do_if>
+          </do_if>
+        </do_all>
+      </actions>
+    </cue>
+
+  </cues>
+</mdscript>

