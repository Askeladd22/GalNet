    <!-- Variabili per impatto, crisi prolungata, cluster multi-settore -->
    <variables>
        <variable name="$XenonCiviliansEvacuated" />
        <variable name="$XenonLogisticsDisrupted" />
        <variable name="$XenonTradeHalted" />
        <variable name="$XenonEscalationStartTime" />
        <variable name="$XenonCrisisProlonged" />
        <variable name="$XenonLiberationTime" />
        <variable name="$XenonRegionCrisis_Sectors" />
        <variable name="$XenonRegionCrisis_Count" />
        <variable name="$XenonRegionCrisis_Timer" />
    </variables>

    <!-- Parametri di impatto su escalation -->
    <cue name="Monitor_Xenon_Escalation_Impact" instantiate="true">
        <conditions>
            <check_value value="$XenonEscalation" min="1" />
        </conditions>
        <actions>
            <set_value name="$XenonEscalationStartTime" now="true" />
        </actions>
    </cue>

    <!-- Escalation temporale: crisi prolungata -->
    <cue name="Trigger_Xenon_Crisis_Prolonged" instantiate="true">
        <conditions>
            <check_value value="$XenonEscalation" min="1" />
            <check_time_since name="$XenonEscalationStartTime" min="1800" /> <!-- 30 minuti -->
        </conditions>
        <actions>
            <signal_cue_instantly cue="GalNet" event="xenon_crisis_prolonged">
                <param name="sector" value="$XenonSector" />
                <param name="threat" value="$XenonThreatLevel" />
            </signal_cue_instantly>
            <set_value name="$XenonCrisisProlonged" exact="1" />
        </actions>
    </cue>

    <!-- Fine crisi: settore liberato dopo escalation/overrun -->
    <cue name="Trigger_Xenon_Crisis_Resolved" instantiate="true">
        <conditions>
            <check_value value="$XenonLiberated" min="1" />
            <check_value value="$XenonEscalationStartTime" min="1" />
        </conditions>
        <actions>
            <set_value name="$XenonLiberationTime" now="true" />
            <signal_cue_instantly cue="GalNet" event="xenon_crisis_resolved">
                <param name="sector" value="$XenonSector" />
                <param name="duration" value="[calc:$XenonLiberationTime-$XenonEscalationStartTime]" />
                <param name="civilians_evacuated" value="$XenonCiviliansEvacuated" />
                <param name="logistics_disrupted" value="$XenonLogisticsDisrupted" />
                <param name="trade_halted" value="$XenonTradeHalted" />
            </signal_cue_instantly>
            <set_value name="$XenonEscalationStartTime" exact="0" />
            <set_value name="$XenonCiviliansEvacuated" exact="0" />
            <set_value name="$XenonLogisticsDisrupted" exact="0" />
            <set_value name="$XenonTradeHalted" exact="0" />
        </actions>
    </cue>

    <!-- Cluster multi-settore: crisi regionale Xenon -->
    <cue name="Accumulate_Xenon_Region_Crisis" instantiate="true">
        <conditions>
            <check_value value="$XenonEscalation" min="1" />
        </conditions>
        <actions>
            <set_value name="$XenonRegionCrisis_Count" op="add" value="1" />
            <set_value name="$XenonRegionCrisis_Sectors" op="concat" value="$XenonSector" sep="," />
            <set_time name="$XenonRegionCrisis_Timer" />
        </actions>
    </cue>

    <cue name="Trigger_Xenon_Region_Crisis_News" instantiate="true">
        <conditions>
            <check_value value="$XenonRegionCrisis_Count" min="2" />
            <check_time_since name="$XenonRegionCrisis_Timer" min="0" max="1800" /> <!-- 30 minuti -->
        </conditions>
        <actions>
            <signal_cue_instantly cue="GalNet" event="xenon_region_crisis">
                <param name="sectors" value="$XenonRegionCrisis_Sectors" />
                <param name="clusters" value="$XenonRegionCrisis_Count" />
            </signal_cue_instantly>
            <set_value name="$XenonRegionCrisis_Count" exact="0" />
            <set_value name="$XenonRegionCrisis_Sectors" exact="" />
        </actions>
    </cue>
<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Xenon_Frontier_Monitor">
    <!--
        Sensore per:
        - Incursione Xenon
        - Escalation Xenon
        - Settore travolto
        - Settore liberato
        Usa template esistenti per traffico, installazioni, evacuazioni, attività militare
        TODO: Implementare logica di monitoraggio e trigger eventi GalNet
    -->
    <variables>
        <variable name="$XenonIncursion" />
        <variable name="$XenonEscalation" />
        <variable name="$XenonOverrun" />
        <variable name="$XenonLiberated" />
        <variable name="$XenonSector" />
        <variable name="$XenonThreatLevel" />
        <variable name="$XenonInstallations" />
        <variable name="$XenonEvacuation" />
        <variable name="$XenonTrafficBlocked" />
    </variables>

    <cues>
        <cue name="Monitor_Xenon_Incursion" instantiate="true">
            <conditions>
                <check_value value="$XenonIncursion" min="1" />
            </conditions>
            <actions>
                <signal_cue_instantly cue="GalNet" event="xenon_incursion">
                    <param name="sector" value="$XenonSector" />
                    <param name="threat" value="$XenonThreatLevel" />
                </signal_cue_instantly>
                <set_value name="$XenonIncursion" exact="0" />
            </actions>
        </cue>

        <cue name="Monitor_Xenon_Escalation" instantiate="true">
            <conditions>
                <check_value value="$XenonEscalation" min="1" />
            </conditions>
            <actions>
                <signal_cue_instantly cue="GalNet" event="xenon_escalation">
                    <param name="sector" value="$XenonSector" />
                    <param name="threat" value="$XenonThreatLevel" />
                    <param name="installations" value="$XenonInstallations" />
                    <if value="$XenonEvacuation" min="1">
                        <param name="evacuation" value="1" />
                    </if>
                    <if value="$XenonTrafficBlocked" min="1">
                        <param name="traffic_blocked" value="1" />
                    </if>
                </signal_cue_instantly>
                <set_value name="$XenonEscalation" exact="0" />
                <set_value name="$XenonEvacuation" exact="0" />
                <set_value name="$XenonTrafficBlocked" exact="0" />
            </actions>
        </cue>

        <cue name="Monitor_Xenon_Overrun" instantiate="true">
            <conditions>
                <check_value value="$XenonOverrun" min="1" />
            </conditions>
            <actions>
                <signal_cue_instantly cue="GalNet" event="xenon_sector_overrun">
                    <param name="sector" value="$XenonSector" />
                    <param name="threat" value="$XenonThreatLevel" />
                    <param name="installations" value="$XenonInstallations" />
                </signal_cue_instantly>
                <set_value name="$XenonOverrun" exact="0" />
            </actions>
        </cue>

        <cue name="Monitor_Xenon_Liberated" instantiate="true">
            <conditions>
                <check_value value="$XenonLiberated" min="1" />
            </conditions>
            <actions>
                <signal_cue_instantly cue="GalNet" event="xenon_sector_liberated">
                    <param name="sector" value="$XenonSector" />
                </signal_cue_instantly>
                <set_value name="$XenonLiberated" exact="0" />
            </actions>
        </cue>
    </cues>
</mdscript>
