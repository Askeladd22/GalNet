<mdscript name="Infrastructure_Events_Monitor">
    <!-- Sensore per eventi infrastrutturali/economici -->

    <cues>
        <cue name="Monitor_Important_Factory_Completion" instantiate="true">
            <conditions>
                <!-- Esempio: controlla se una fabbrica importante è stata completata -->
                <check_value value="$FactoryCompleted" min="1" />
            </conditions>
            <actions>
                <!-- Trigger evento GalNet sempre -->
                <signal_cue_instantly cue="GalNet" event="infrastructure_factory_completed">
                    <param name="sector" value="$FactorySector" />
                    <param name="faction" value="$FactoryFaction" />
                    <param name="station" value="$FactoryName" />
                    <!-- Parametri opzionali: -->
                    <if value="$FactoryFirstOfType" min="1">
                        <param name="first_of_type" value="1" />
                    </if>
                    <if value="$FactoryShortageRelieved" min="1">
                        <param name="shortage_relieved" value="1" />
                    </if>
                </signal_cue_instantly>
                <!-- Reset variabili per evitare spam -->
                <set_value name="$FactoryCompleted" exact="0" />
                <set_value name="$FactoryFirstOfType" exact="0" />
                <set_value name="$FactoryShortageRelieved" exact="0" />
            </actions>
        </cue>
    </cues>
</mdscript>
