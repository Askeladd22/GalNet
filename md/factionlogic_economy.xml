<?xml version="1.0" encoding="UTF-8"?>
<diff>
	<!-- Controlla le richieste di freighter/miner prioritari: problema di trasporto, non di fabbriche -->
	<add sel="//cue[@name='Request_Freighter']/actions/do_if[@value='$DebugChance == 100']" pos="before">
		<do_if value="$Priority">
			<signal_cue_instantly cue="md.Event_driven_news.Market_Chatter_Freighter_Needed" param="[$Ware, $Requester, $Faction, $Miner, $RequestSector]"/>
		</do_if>
	</add>
	<!-- Controlla le richieste di nuove fabbriche: indica una carenza di merce -->
	<add sel="//cue[@name='Request_Factory']/actions/do_if[@value='$Ware.hastag.minable']" pos="before">
		<signal_cue_instantly cue="md.Event_driven_news.Market_Chatter_Factory_Needed" param="[$Ware, $RequestSector, $Faction]"/>
	</add>
	<!-- Controlla le richieste di pausa della produzione per merce in eccesso -->
    <add sel="//cue[@name='Pause_Production_Module']/actions/do_elseif[@value='$Product.hastag.minable']/cancel_cue" pos="before">
        <signal_cue_instantly cue="md.Event_driven_news.Market_Chatter_Pause_Production" param="[$Product, $RequestSector, $Faction]"/>
    </add>
    <add sel="//cue[@name='Pause_Production_Module']/actions/do_else/do_if[@value='$Station']/debug_text" pos="before">
        <signal_cue_instantly cue="md.Event_driven_news.Market_Chatter_Pause_Production" param="[$Product, $RequestSector, $Faction]"/>
    </add>
</diff>
