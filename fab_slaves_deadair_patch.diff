+++ b/extensions/fab_slaves_tradeware/md/slaves_prison_deadair_bridge.xml
@@ -1,0 +1,186 @@
+<?xml version="1.0" encoding="utf-8"?>
+<mdscript name="fab_slaves_prison_deadair_bridge">
+  <cues>
+
+    <cue name="DeadAirGodQuotaBridge" instantiate="true" checktime="5min" checkinterval="30min">
+      <actions>
+        <do_if value="md.$DADynamicVarTable? and md.$DADynamicVarTable.$DAGodFactionModuleQuotas?">
+          <set_value name="$DADVT" exact="md.$DADynamicVarTable"/>
+
+          <do_if value="$DADVT.$DAGodFactionModuleQuotas.{faction.split}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.split" race="faction.split.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.split}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.split}.{ware.slaves}" exact="[$SlavesModule,2]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.split}.{ware.slaves}.{2} lt 2">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.split}.{ware.slaves}.{2}" exact="2"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+
+          <do_if value="$DADVT.$DAGodFactionModuleQuotas.{faction.freesplit}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.freesplit" race="faction.freesplit.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.freesplit}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.freesplit}.{ware.slaves}" exact="[$SlavesModule,1]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.freesplit}.{ware.slaves}.{2} lt 1">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.freesplit}.{ware.slaves}.{2}" exact="1"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+
+          <do_if value="$DADVT.$DAGodFactionModuleQuotas.{faction.scaleplate}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.scaleplate" race="faction.scaleplate.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.scaleplate}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.scaleplate}.{ware.slaves}" exact="[$SlavesModule,1]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.scaleplate}.{ware.slaves}.{2} lt 1">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.scaleplate}.{ware.slaves}.{2}" exact="1"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+
+          <do_if value="faction.loanshark? and $DADVT.$DAGodFactionModuleQuotas.{faction.loanshark}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.loanshark" race="faction.loanshark.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.loanshark}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.loanshark}.{ware.slaves}" exact="[$SlavesModule,1]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.loanshark}.{ware.slaves}.{2} lt 1">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.loanshark}.{ware.slaves}.{2}" exact="1"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+
+          <do_if value="faction.yaki? and $DADVT.$DAGodFactionModuleQuotas.{faction.yaki}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.yaki" race="faction.yaki.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.yaki}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.yaki}.{ware.slaves}" exact="[$SlavesModule,1]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.yaki}.{ware.slaves}.{2} lt 1">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.yaki}.{ware.slaves}.{2}" exact="1"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+
+          <do_if value="faction.buccaneers? and $DADVT.$DAGodFactionModuleQuotas.{faction.buccaneers}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.buccaneers" race="faction.buccaneers.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.buccaneers}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.buccaneers}.{ware.slaves}" exact="[$SlavesModule,1]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.buccaneers}.{ware.slaves}.{2} lt 1">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.buccaneers}.{ware.slaves}.{2}" exact="1"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+
+          <do_if value="faction.fallensplit? and $DADVT.$DAGodFactionModuleQuotas.{faction.fallensplit}?">
+            <get_module_definition macro="$SlavesModule" tags="[tag.production, tag.module]" faction="faction.fallensplit" race="faction.fallensplit.primaryrace" ware="ware.slaves"/>
+            <do_if value="$SlavesModule">
+              <do_if value="not $DADVT.$DAGodFactionModuleQuotas.{faction.fallensplit}.{ware.slaves}?">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.fallensplit}.{ware.slaves}" exact="[$SlavesModule,1]"/>
+              </do_if>
+              <do_elseif value="$DADVT.$DAGodFactionModuleQuotas.{faction.fallensplit}.{ware.slaves}.{2} lt 1">
+                <set_value name="$DADVT.$DAGodFactionModuleQuotas.{faction.fallensplit}.{ware.slaves}.{2}" exact="1"/>
+              </do_elseif>
+            </do_if>
+            <remove_value name="$SlavesModule"/>
+          </do_if>
+        </do_if>
+      </actions>
+    </cue>
+
+    <cue name="PrisonBuildBackstop" instantiate="true" checktime="45min" checkinterval="90min">
+      <actions>
+        <set_value name="$PrisonFactionList" exact="[faction.scaleplate, faction.split, faction.freesplit]"/>
+        <do_if value="faction.loanshark?">
+          <append_to_list name="$PrisonFactionList" exact="faction.loanshark"/>
+        </do_if>
+        <do_if value="faction.yaki?">
+          <append_to_list name="$PrisonFactionList" exact="faction.yaki"/>
+        </do_if>
+        <do_if value="faction.buccaneers?">
+          <append_to_list name="$PrisonFactionList" exact="faction.buccaneers"/>
+        </do_if>
+        <do_if value="faction.fallensplit?">
